---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import {
  forfaitComparisonRows,
  forfaitsPageLead,
  packages,
  seoForfaitsDescription,
  siteConfig,
} from "@/config";
---

<Layout
  title="Forfaits & Tarifs Création de Sites"
  description={seoForfaitsDescription()}
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white/50 py-10 sm:py-12">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Forfaits &amp; tarifs
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {forfaitsPageLead}
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
    <section aria-labelledby="forfaits-grid-title">
      <h2 id="forfaits-grid-title" class="sr-only">
        Grille des forfaits {siteConfig.siteName}
      </h2>

      <div class="grid gap-6 md:grid-cols-3">
        {
          packages.map((pkg) => (
            <article
              id={pkg.id}
              class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
              itemscope
              itemtype="https://schema.org/Offer"
            >
              <meta itemprop="name" content={`Forfait ${pkg.name} — ${siteConfig.siteName}`} />
              <h2 class="font-display text-2xl font-bold text-slate-900" itemprop="category">
                Forfait {pkg.name}
              </h2>
              <p class="mt-2 text-xl font-semibold text-teal-700" itemprop="priceSpecification">
                Prix : {pkg.priceLabel}
              </p>
              <p class="mt-2 text-sm text-slate-600" itemprop="description">
                {pkg.tagline}
              </p>

              <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-slate-800">
                Livrables inclus
              </h3>
              <ul class="mt-3 flex-1 space-y-2 text-sm text-slate-700" role="list">
                {
                  pkg.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <span
                        class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))
                }
              </ul>

              <a
                href="/contact"
                class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-teal-600 px-4 text-sm font-semibold text-white no-underline hover:bg-teal-700 hover:no-underline"
              >
                {pkg.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-16" aria-labelledby="comparatif-title">
      <h2
        id="comparatif-title"
        class="font-display text-2xl font-bold text-slate-900"
      >
        Comparatif rapide
      </h2>
      <p class="mt-2 text-base text-slate-600">
        Ce qui change d'un palier à l'autre, en résumé — prix et périmètres explicites pour faciliter
        la comparaison.
      </p>

      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            Comparatif des forfaits Essentiel, Pro et Sur mesure &amp; IA — Studio Lecart
          </caption>
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th scope="col" class="px-4 py-3 font-semibold text-slate-900">Thème</th>
              <th scope="col" class="px-4 py-3 font-semibold text-slate-900">
                Forfait Essentiel
              </th>
              <th scope="col" class="px-4 py-3 font-semibold text-slate-900">Forfait Pro</th>
              <th scope="col" class="px-4 py-3 font-semibold text-slate-900">
                Forfait Sur mesure &amp; IA
              </th>
            </tr>
          </thead>
          <tbody>
            {
              forfaitComparisonRows.map((row) => (
                <tr class="border-b border-slate-100 last:border-b-0">
                  <th scope="row" class="px-4 py-3 font-medium text-slate-800">
                    {row.theme}
                  </th>
                  <td class="px-4 py-3 text-slate-700">{row.essentiel}</td>
                  <td class="px-4 py-3 text-slate-700">{row.pro}</td>
                  <td class="px-4 py-3 text-slate-700">{row.surMesure}</td>
                </tr>
              ))
            }
            <tr class="bg-slate-50/80">
              <th scope="row" class="px-4 py-3 font-medium text-slate-800">
                Maintenance
              </th>
              <td colspan="3" class="px-4 py-3 text-center text-slate-600">
                Option mensuelle possible : mises à jour, petites évolutions, veille — à définir
                au devis.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <p class="mt-10 text-center">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-6 text-sm font-semibold text-white no-underline hover:bg-slate-800 hover:no-underline"
      >
        Demander un devis personnalisé
      </a>
    </p>
  </div>
</Layout>
