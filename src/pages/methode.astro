---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { methodePageLead, methodeSteps, seoMethodeDescription } from "@/config";
---

<Layout
  title="Méthode de travail"
  description={seoMethodeDescription()}
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white/50 py-10 sm:py-12">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Méthode
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {methodePageLead}
      </p>
    </div>
  </header>

  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-14">
    <h2 class="sr-only">Étapes du projet web avec Studio Lecart</h2>

    <ol class="space-y-8 border-l-2 border-teal-200 pl-6 sm:pl-8" role="list">
      {
        methodeSteps.map((step, index) => (
          <li class="relative">
            <span
              class="absolute -left-[calc(1.5rem+5px)] flex h-8 w-8 items-center justify-center rounded-full bg-teal-600 text-sm font-bold text-white sm:-left-[calc(2rem+5px)]"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="font-display text-lg font-semibold text-slate-900">
              {step.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-slate-700">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 text-center">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-teal-600 px-6 text-sm font-semibold text-white no-underline hover:bg-teal-700 hover:no-underline"
      >
        Lancer un brief
      </a>
    </p>
  </article>
</Layout>
