---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import Hero from "@/components/home/Hero.astro";
import HomePortfolio from "@/components/home/HomePortfolio.astro";
import HomeServices from "@/components/home/HomeServices.astro";
import HomeWhy from "@/components/home/HomeWhy.astro";
import IaBand from "@/components/home/IaBand.astro";
import HomePackages from "@/components/home/HomePackages.astro";
import HomeCta from "@/components/home/HomeCta.astro";
import HomeFaq from "@/components/home/HomeFaq.astro";
import { buildHomeFaq, seoHomeDescription } from "@/config";

const faqItems = buildHomeFaq();
---

<Layout title="Accueil" description={seoHomeDescription()} faqItems={faqItems}>
  <Navbar />
  <Hero />
  <HomePortfolio />
  <HomeServices />
  <HomeWhy />
  <IaBand />
  <HomePackages />
  <HomeCta />
  <HomeFaq />
</Layout>
