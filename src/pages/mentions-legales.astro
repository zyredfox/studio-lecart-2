---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { seoMentionsLegalesDescription, siteConfig } from "@/config";

const year = new Date().getFullYear();
---

<Layout
  title="Mentions légales"
  description={seoMentionsLegalesDescription()}
  robots="noindex, nofollow"
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white/50 py-10 sm:py-12">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900">
        Mentions légales
      </h1>
    </div>
  </header>

  <article class="mx-auto max-w-2xl space-y-8 px-4 py-12 text-base leading-relaxed text-slate-700 sm:px-6">
    <section aria-labelledby="legal-editor">
      <h2 id="legal-editor" class="font-display text-lg font-semibold text-slate-900">
        Éditeur du site
      </h2>
      <p class="mt-2">
        {siteConfig.siteName}<br />
        Responsable : {siteConfig.founderName}<br />
        {siteConfig.addressLine}<br />
        {siteConfig.founderCity}, {siteConfig.country}<br />
        SIRET : {siteConfig.siret}<br />
        E-mail : <a href={`mailto:${siteConfig.email}`} class="text-teal-700 no-underline hover:underline">{siteConfig.email}</a>
      </p>
    </section>

    <section aria-labelledby="legal-hosting">
      <h2 id="legal-hosting" class="font-display text-lg font-semibold text-slate-900">
        Hébergement
      </h2>
      <p class="mt-2">
        Netlify, Inc. — 512 2nd Street, Fl 2, San Francisco, CA 94107, États-Unis —
        <a href="https://www.netlify.com" class="text-teal-700 no-underline hover:underline" rel="noopener noreferrer" target="_blank">netlify.com</a>
      </p>
    </section>

    <section aria-labelledby="legal-ip">
      <h2 id="legal-ip" class="font-display text-lg font-semibold text-slate-900">
        Propriété intellectuelle
      </h2>
      <p class="mt-2">
        Les contenus présents sur ce site (textes, visuels, structure) sont la propriété de
        {siteConfig.siteName} sauf mention contraire. Toute reproduction non autorisée est interdite.
      </p>
    </section>

    <section aria-labelledby="legal-data">
      <h2 id="legal-data" class="font-display text-lg font-semibold text-slate-900">
        Données personnelles
      </h2>
      <p class="mt-2">
        Le formulaire de contact est géré par Netlify Forms : les données transmises servent uniquement
        à répondre à votre demande. Pour toute question :
        <a href={`mailto:${siteConfig.email}`} class="text-teal-700 no-underline hover:underline">{siteConfig.email}</a>.
      </p>
    </section>

    <section aria-labelledby="legal-credits">
      <h2 id="legal-credits" class="font-display text-lg font-semibold text-slate-900">
        Crédits
      </h2>
      <p class="mt-2">
        Conception &amp; développement : {siteConfig.siteName} — {siteConfig.founderName}.<br />
        © {year} — Tous droits réservés.
      </p>
    </section>
  </article>
</Layout>
