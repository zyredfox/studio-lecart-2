---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { seoContactDescription, siteConfig } from "@/config";
---

<Layout
  title="Contact & Devis"
  description={seoContactDescription()}
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white/50 py-10 sm:py-12">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Contact
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        Décrivez votre projet en quelques lignes —
        <strong>{siteConfig.founderFirstName}</strong> ({siteConfig.founderCity}) vous répond sous
        quelques jours ouvrés.
      </p>
    </div>
  </header>

  <section class="py-12 sm:py-14" aria-labelledby="contact-form-title">
    <div class="mx-auto max-w-xl px-4 sm:px-6">
      <div class="mb-8 text-center text-sm text-slate-600">
        <p>
          <a
            href={`mailto:${siteConfig.email}`}
            class="font-medium text-teal-700 no-underline hover:text-teal-900 hover:no-underline"
          >
            {siteConfig.email}
          </a>
          <span aria-hidden="true"> · </span>
          <a
            href={`tel:${siteConfig.phone}`}
            class="font-medium text-teal-700 no-underline hover:text-teal-900 hover:no-underline"
          >
            {siteConfig.phoneDisplay}
          </a>
        </p>
        {
          siteConfig.calendarUrl ? (
            <p class="mt-3">
              <a
                href={siteConfig.calendarUrl}
                class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-800 no-underline hover:border-teal-400 hover:no-underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                Réserver un créneau
              </a>
            </p>
          ) : null
        }
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 id="contact-form-title" class="sr-only">
          Formulaire de contact
        </h2>

        <form
          name="contact"
          method="POST"
          action="/contact"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />

          <p class="hidden" aria-hidden="true">
            <label>
              Ne pas remplir ce champ
              <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div>
            <label for="contact-name" class="block text-sm font-medium text-slate-800">
              Nom
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              class="mt-1.5 block w-full min-h-11 rounded-xl border border-slate-300 px-3 py-2 text-base text-slate-900 shadow-sm focus-visible:border-teal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/30"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-medium text-slate-800">
              E-mail <span class="text-teal-700">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="mt-1.5 block w-full min-h-11 rounded-xl border border-slate-300 px-3 py-2 text-base text-slate-900 shadow-sm focus-visible:border-teal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/30"
            />
          </div>

          <div>
            <label for="contact-entreprise" class="block text-sm font-medium text-slate-800">
              Entreprise
            </label>
            <input
              id="contact-entreprise"
              name="entreprise"
              type="text"
              autocomplete="organization"
              class="mt-1.5 block w-full min-h-11 rounded-xl border border-slate-300 px-3 py-2 text-base text-slate-900 shadow-sm focus-visible:border-teal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/30"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-slate-800">
              Message <span class="text-teal-700">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows={6}
              placeholder="Votre activité, ce que vous cherchez, vos délais…"
              class="mt-1.5 block w-full min-h-[8rem] resize-y rounded-xl border border-slate-300 px-3 py-2 text-base text-slate-900 shadow-sm focus-visible:border-teal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/30"
            />
          </div>

          <button
            type="submit"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-teal-600 px-5 text-sm font-semibold text-white shadow-md shadow-teal-900/15 hover:bg-teal-700"
          >
            Envoyer ma demande
          </button>
        </form>

        <p class="mt-4 text-center text-xs text-slate-500">
          Formulaire géré par Netlify — aucun script JavaScript côté navigateur. Vos données sont
          transmises de façon sécurisée pour traitement par {siteConfig.siteName}.
        </p>
      </div>

      <p class="mt-8 text-center text-sm">
        <a
          href="/forfaits"
          class="font-medium text-teal-700 no-underline hover:text-teal-900 hover:no-underline"
        >
          Voir les forfaits
        </a>
      </p>
    </div>
  </section>
</Layout>
