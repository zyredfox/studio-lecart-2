---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { caseStudies, portfolioPageLead, seoPortfolioDescription } from "@/config";
---

<Layout
  title="Portfolio & Réalisations Web"
  description={seoPortfolioDescription()}
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white/50 py-10 sm:py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Portfolio
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {portfolioPageLead}
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl space-y-10 px-4 py-12 sm:px-6 sm:py-14">
    {
      caseStudies.map((study) => (
        <article
          id={study.id}
          class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
          itemscope
          itemtype="https://schema.org/CreativeWork"
        >
          <header class="border-b border-slate-100 pb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">
              {study.sector}
            </p>
            <h2 class="mt-2 font-display text-2xl font-bold text-slate-900" itemprop="name">
              {study.title}
            </h2>
            <p class="mt-2 text-sm font-medium text-slate-800">
              <span class="text-slate-500">Client :</span> {study.client}
            </p>
            {study.resultUrl ? (
              <p class="mt-2 text-sm">
                <span class="text-slate-500">Site en ligne :</span>{" "}
                <a
                  href={study.resultUrl}
                  class="font-medium text-teal-700 no-underline hover:text-teal-900 hover:underline"
                  itemprop="url"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {study.resultUrl}
                </a>
              </p>
            ) : null}
          </header>

          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <section aria-labelledby={`${study.id}-problem`}>
              <h3
                id={`${study.id}-problem`}
                class="text-sm font-semibold uppercase tracking-wide text-teal-800"
              >
                Problème
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-700" itemprop="description">
                {study.problem}
              </p>
            </section>

            <section aria-labelledby={`${study.id}-solution`}>
              <h3
                id={`${study.id}-solution`}
                class="text-sm font-semibold uppercase tracking-wide text-teal-800"
              >
                Solution technique (Studio Lecart)
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-700">
                {study.solution}
              </p>
            </section>
          </div>

          <section class="mt-6" aria-labelledby={`${study.id}-results`}>
            <h3
              id={`${study.id}-results`}
              class="text-sm font-semibold uppercase tracking-wide text-teal-800"
            >
              Résultats factuels
            </h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-700" role="list">
              {
                study.results.map((result) => (
                  <li class="flex gap-2">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600"
                      aria-hidden="true"
                    />
                    <span>{result}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="mt-6" aria-labelledby={`${study.id}-stack`}>
            <h3
              id={`${study.id}-stack`}
              class="text-sm font-semibold uppercase tracking-wide text-slate-600"
            >
              Stack
            </h3>
            <ul class="mt-2 flex flex-wrap gap-2" role="list">
              {
                study.stack.map((tech) => (
                  <li>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                      {tech}
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>
        </article>
      ))
    }

    <p class="text-center">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-teal-600 px-6 text-sm font-semibold text-white no-underline hover:bg-teal-700 hover:no-underline"
      >
        Discuter d'un projet similaire
      </a>
    </p>
  </div>
</Layout>
