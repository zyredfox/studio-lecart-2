---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import CaseStudyArticle from "@/components/portfolio/CaseStudyArticle.astro";
import {
  caseStudies,
  getPortfolioThumbnail,
  portfolioPageLead,
  seoPortfolioDescription,
} from "@/config";
---

<Layout
  title="Portfolio & Réalisations Web"
  description={seoPortfolioDescription()}
  schemaType="WebPage"
>
  <Navbar />

  <header class="border-b border-slate-200/80 bg-white py-10 sm:py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Portfolio
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {portfolioPageLead}
      </p>
    </div>
  </header>

  <div class="bg-white">
    <div class="mx-auto max-w-6xl space-y-14 px-4 py-12 sm:px-6 sm:py-14">
    {
      caseStudies.map((study) => (
        <CaseStudyArticle
          study={study}
          thumbnail={getPortfolioThumbnail(study.id)}
        />
      ))
    }

    <p class="text-center">
      <a href="/contact" class="sl-btn-primary"> Discuter d'un projet similaire </a>
    </p>
    </div>
  </div>
</Layout>
