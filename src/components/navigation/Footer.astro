---
import { footerNavItems, siteConfig } from "@/config";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-teal-900/10 bg-slate-900 text-slate-200">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 md:py-8">
    <div class="grid gap-5 md:grid-cols-3 md:items-start md:gap-8">
      <div class="min-w-0">
        <p class="font-display text-base font-semibold text-white md:text-lg">
          {siteConfig.siteName}
        </p>
        <p class="mt-1.5 text-xs leading-snug text-slate-400 md:mt-2 md:text-sm">
          {siteConfig.footerTagline}
        </p>
      </div>

      <!-- Liens + contact côte à côte sur mobile ; 3 colonnes dès md -->
      <div class="grid grid-cols-2 gap-4 md:contents md:gap-0">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wide text-teal-300">
            Liens
          </h2>
          <ul
            class="mt-2 grid grid-cols-2 gap-x-3 gap-y-2 text-xs md:mt-2.5 md:max-w-[14rem] md:text-sm"
            role="list"
          >
            {
              footerNavItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex min-h-11 items-center py-0.5 text-slate-300 no-underline hover:text-white hover:no-underline"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wide text-teal-300">
            Contact
          </h2>
          <address class="mt-2 space-y-1 text-xs not-italic text-slate-300 md:text-sm">
            <p>
              <a
                href={`mailto:${siteConfig.email}`}
                class="break-all text-slate-300 no-underline hover:text-white hover:no-underline"
              >
                {siteConfig.email}
              </a>
            </p>
            <p>
              <a
                href={`tel:${siteConfig.phone}`}
                class="text-slate-300 no-underline hover:text-white hover:no-underline"
              >
                {siteConfig.phoneDisplay}
              </a>
            </p>
            <p class="leading-snug">
              {siteConfig.addressLine}
              <br />
              <span class="text-slate-400">
                {siteConfig.founderCity}, {siteConfig.country}
              </span>
            </p>
          </address>
        </div>
      </div>
    </div>

    <p class="mt-5 border-t border-slate-700 pt-4 text-center text-xs text-slate-400 md:mt-6">
      © {year} {siteConfig.siteName}. Tous droits réservés.
    </p>
  </div>
</footer>
