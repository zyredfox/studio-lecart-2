---
import { navItems, siteConfig } from "@/config";
import { isNavActive } from "@/lib/nav";

const currentPath = Astro.url.pathname;
const toggleId = "nav-drawer-toggle";

const drawerLinkClass = (href: string, end?: boolean) => {
  const active = isNavActive(currentPath, href, end);
  return [
    "flex min-h-12 items-center rounded-xl px-4 text-base font-medium no-underline transition-colors",
    active
      ? "bg-teal-50 text-sl-accent-hover"
      : "text-stone-700 hover:bg-stone-100 hover:text-sl-accent-hover hover:no-underline",
  ].join(" ");
};
---

<!-- État menu mobile : checkbox (zéro JS) -->
<input
  type="checkbox"
  id={toggleId}
  class="nav-drawer-toggle sr-only"
/>

<header
  class="sticky top-0 z-50 border-b border-teal-900/10 bg-white/95 shadow-sm shadow-slate-900/5 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="flex min-h-11 min-w-0 flex-col justify-center rounded-lg no-underline hover:no-underline focus-visible:outline-sl-accent"
    >
      <span class="font-display text-lg font-semibold tracking-tight text-slate-900">
        {siteConfig.siteName}
      </span>
      <span class="hidden text-xs text-slate-600 sm:inline">
        {siteConfig.founderFirstName} · {siteConfig.founderCity} · Sites sur mesure
      </span>
    </a>

    <nav
      class="hidden items-center gap-1 md:flex"
      aria-label="Navigation principale"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex min-h-11 items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors no-underline",
              isNavActive(currentPath, item.href, item.end)
                ? "bg-teal-50 text-sl-accent-hover"
                : "text-slate-700 hover:bg-slate-100 hover:text-sl-accent-hover hover:no-underline",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/contact"
        class="sl-btn-primary hidden shadow-md shadow-teal-900/15 md:inline-flex"
      >
        Parler à {siteConfig.founderFirstName}
      </a>

      <!-- Burger (fermé) -->
      <label
        for={toggleId}
        class="nav-burger-open flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-slate-800 md:hidden"
        aria-label="Ouvrir le menu de navigation"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </label>

      <!-- Croix dans la barre (ouvert) -->
      <label
        for={toggleId}
        class="nav-burger-close hidden min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-slate-800 md:hidden"
        aria-label="Fermer le menu de navigation"
      >
        <span class="sr-only">Fermer le menu</span>
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </label>
    </div>
  </div>
</header>

<!-- Overlay assombri + flou -->
<label
  for={toggleId}
  class="nav-drawer-backdrop fixed inset-0 z-[60] cursor-pointer bg-slate-900/55 backdrop-blur-sm md:hidden"
  aria-hidden="true"
>
  <span class="sr-only">Fermer le menu</span>
</label>

<!-- Tiroir latéral (div : aside + role=dialog est invalide pour axe) -->
<div
  class="nav-drawer fixed top-0 left-0 z-[70] flex h-dvh w-[min(20rem,88vw)] max-w-sm flex-col border-r border-stone-200 bg-stone-50 shadow-2xl shadow-slate-900/25 md:hidden"
>
  <div
    class="flex shrink-0 items-center justify-between gap-3 border-b border-stone-200 bg-stone-50 px-5 pb-4 pt-[max(1rem,env(safe-area-inset-top))]"
  >
    <div class="min-w-0">
      <p class="font-display text-lg font-bold leading-tight text-slate-900">
        {siteConfig.siteName}
      </p>
      <p class="text-xs text-stone-600">
        {siteConfig.founderFirstName} · {siteConfig.founderCity}
      </p>
    </div>
    <label
      for={toggleId}
      class="flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-stone-300 bg-white text-slate-700 transition hover:border-teal-300 hover:bg-teal-50"
      aria-label="Fermer le menu"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
      </svg>
    </label>
  </div>

  <nav
    class="flex flex-1 flex-col gap-1 overflow-y-auto bg-stone-50 px-4 py-4"
    aria-label="Navigation mobile"
  >
    <p class="px-4 pb-2 text-xs font-semibold uppercase tracking-widest text-stone-500">
      Menu
    </p>
    {
      navItems.map((item) => (
        <a href={item.href} class={drawerLinkClass(item.href, item.end)}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div
    class="shrink-0 border-t border-stone-200 bg-stone-50 px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]"
  >
    <a
      href="/contact"
      class="sl-btn-primary min-h-12 w-full text-base shadow-md"
    >
      Parler à {siteConfig.founderFirstName}
    </a>
  </div>
</div>
