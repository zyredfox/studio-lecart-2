---
import { navItems, siteConfig } from "@/config";
import { isNavActive } from "@/lib/nav";

const currentPath = Astro.url.pathname;
const navLinkClass = (href: string, end?: boolean) => {
  const active = isNavActive(currentPath, href, end);
  return [
    "flex min-h-11 items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors",
    active
      ? "bg-teal-50 text-teal-900"
      : "text-slate-700 hover:bg-slate-100 hover:text-teal-800",
  ].join(" ");
};
---

<header
  class="sticky top-0 z-50 border-b border-teal-900/10 bg-white/95 shadow-sm shadow-slate-900/5 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="flex min-h-11 min-w-0 flex-col justify-center rounded-lg no-underline hover:no-underline focus-visible:outline-teal-600"
    >
      <span class="font-display text-lg font-semibold tracking-tight text-slate-900">
        {siteConfig.siteName}
      </span>
      <span class="text-xs text-slate-600">
        {siteConfig.founderFirstName} · {siteConfig.founderCity} · Sites sur mesure
      </span>
    </a>

    <!-- Navigation desktop -->
    <nav
      class="hidden items-center gap-1 md:flex"
      aria-label="Navigation principale"
    >
      {
        navItems.map((item) => (
          <a href={item.href} class={navLinkClass(item.href, item.end)}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/contact"
      class="hidden min-h-11 items-center justify-center rounded-xl bg-teal-600 px-4 text-sm font-semibold text-white no-underline shadow-md shadow-teal-900/15 transition hover:bg-teal-700 hover:no-underline md:inline-flex"
    >
      Parler à {siteConfig.founderFirstName}
    </a>

    <!-- Menu mobile : <details> natif, zéro React -->
    <details class="group relative md:hidden">
      <summary
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-800 [&::-webkit-details-marker]:hidden"
        aria-label="Ouvrir le menu de navigation"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="h-6 w-6 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
        <svg
          class="hidden h-6 w-6 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </summary>

      <div
        class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-[min(100vw-2rem,20rem)] rounded-xl border border-slate-200 bg-white p-2 shadow-xl shadow-slate-900/10"
      >
        <p class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          Menu
        </p>
        <nav aria-label="Navigation mobile">
          {
            navItems.map((item) => (
              <a href={item.href} class={navLinkClass(item.href, item.end)}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          href="/contact"
          class="mt-2 flex min-h-11 w-full items-center justify-center rounded-xl bg-teal-600 px-4 text-sm font-semibold text-white no-underline hover:bg-teal-700 hover:no-underline"
        >
          Parler à {siteConfig.founderFirstName}
        </a>
      </div>
    </details>
  </div>
</header>
