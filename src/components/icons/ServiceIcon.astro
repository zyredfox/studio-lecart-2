---
export type ServiceIconId = "vitrine" | "agents" | "data";

interface Props {
  id: ServiceIconId;
  class?: string;
}

const { id, class: className = "h-8 w-8 text-sl-accent" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    id === "vitrine" && (
      <>
        <rect x="4" y="6" width="24" height="20" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M4 12h24" stroke="currentColor" stroke-width="2" />
        <path
          d="M10 18h8M10 22h12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    id === "agents" && (
      <>
        <circle cx="16" cy="12" r="5" stroke="currentColor" stroke-width="2" />
        <path
          d="M8 26c0-4.4 3.6-8 8-8s8 3.6 8 8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          d="M22 10l2-2M24 16h3"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    id === "data" && (
      <>
        <ellipse cx="16" cy="9" rx="10" ry="4" stroke="currentColor" stroke-width="2" />
        <path
          d="M6 9v8c0 2.2 4.5 4 10 4s10-1.8 10-4V9M6 17v6c0 2.2 4.5 4 10 4s10-1.8 10-4v-6"
          stroke="currentColor"
          stroke-width="2"
        />
      </>
    )
  }
</svg>
