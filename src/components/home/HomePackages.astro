---
import { homePackagesSection, packages } from "@/config";
---

<section
  class="border-t border-slate-200/80 bg-white/40 py-14 sm:py-16"
  aria-labelledby="home-packages-title"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2
      id="home-packages-title"
      class="font-display text-2xl font-bold text-slate-900 sm:text-3xl"
    >
      {homePackagesSection.title}
    </h2>
    <p class="mt-3 max-w-2xl text-base text-slate-600">
      {homePackagesSection.lead}
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        packages.map((pkg) => (
          <article
            id={pkg.id}
            class:list={[
              "flex flex-col rounded-2xl border bg-white p-6 shadow-sm transition hover:shadow-md",
              pkg.id === "pro"
                ? "border-teal-300 ring-2 ring-teal-100 md:max-lg:col-span-2"
                : "border-slate-200",
            ]}
          >
            <h3 class="font-display text-xl font-semibold text-slate-900">
              {pkg.name}
            </h3>
            <p class="mt-1 text-lg font-semibold text-teal-700">{pkg.priceLabel}</p>
            <p class="mt-2 text-sm text-slate-600">{pkg.tagline}</p>

            <ul class="mt-4 flex-1 space-y-2 text-sm text-slate-700" role="list">
              {
                pkg.bullets.slice(0, 3).map((bullet) => (
                  <li class="flex gap-2">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600"
                      aria-hidden="true"
                    />
                    <span>{bullet}</span>
                  </li>
                ))
              }
            </ul>

            <a
              href="/forfaits"
              class="mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 no-underline hover:border-teal-400 hover:text-teal-800 hover:no-underline"
            >
              Détails &amp; comparatif
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
