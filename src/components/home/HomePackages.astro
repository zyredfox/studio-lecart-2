---
import { homePackagesSection, packages } from "@/config";
import SectionShell from "@/components/ui/SectionShell.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
---

<SectionShell tone="muted">
  <SectionHeader
    title={homePackagesSection.title}
    titleId="home-packages-title"
    lead={homePackagesSection.lead}
  />

  <div class="mt-12 grid items-stretch gap-6 lg:grid-cols-3">
    {
      packages.map((pkg) => {
        const isPro = pkg.id === "pro";
        return (
          <article
            id={pkg.id}
            class:list={[
              "relative flex flex-col rounded-(--radius-sl-lg) border bg-white p-6 shadow-[var(--shadow-sl-card)] transition motion-safe:hover:shadow-[var(--shadow-sl-elevated)]",
              isPro
                ? "border-sl-accent/50 ring-2 ring-sl-accent/15 lg:-translate-y-2 lg:scale-[1.02]"
                : "border-slate-200/90",
            ]}
          >
            {pkg.featuredBadge ? (
              <span class="absolute -top-3 left-6 rounded-full bg-sl-accent px-3 py-1 text-xs font-semibold text-white">
                {pkg.featuredBadge}
              </span>
            ) : null}
            <h3 class="font-display text-xl font-semibold text-slate-900">{pkg.name}</h3>
            <p class="mt-2 font-display text-2xl font-bold tracking-tight text-sl-accent-text">
              {pkg.priceLabel}
            </p>
            <p class="mt-2 text-sm text-slate-600">{pkg.tagline}</p>

            <ul class="mt-5 flex-1 space-y-2.5 text-sm text-slate-700" role="list">
              {
                pkg.bullets.slice(0, 3).map((bullet) => (
                  <li class="flex gap-2.5">
                    <svg
                      class="mt-0.5 h-5 w-5 shrink-0 text-sl-accent-text"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.25a1 1 0 0 1-1.414 0l-3.25-3.25a1 1 0 1 1 1.414-1.414l2.543 2.543 6.543-6.543a1 1 0 0 1 1.413 0Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{bullet}</span>
                  </li>
                ))
              }
            </ul>

            <a
              href="/forfaits"
              class:list={[
                "mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-(--radius-sl) px-4 text-sm font-semibold no-underline hover:no-underline",
                isPro
                  ? "bg-sl-accent text-white hover:bg-sl-accent-hover"
                  : "border border-slate-300 bg-white text-slate-800 hover:border-sl-accent hover:text-sl-accent-hover",
              ]}
            >
              Détails &amp; comparatif
            </a>
          </article>
        );
      })
    }
  </div>
</SectionShell>
