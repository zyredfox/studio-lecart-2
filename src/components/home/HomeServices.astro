---
import { serviceOffers, siteConfig } from "@/config";
import SectionShell from "@/components/ui/SectionShell.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ServiceIcon from "@/components/icons/ServiceIcon.astro";
import type { ServiceIconId } from "@/components/icons/ServiceIcon.astro";

const featured = serviceOffers.find((o) => o.featured) ?? serviceOffers[1];
const others = serviceOffers.filter((o) => o.id !== featured.id);
---

<SectionShell tone="inset">
  <SectionHeader
    kicker={siteConfig.servicesIaSectionKicker}
    title="Services IA & web"
    titleId="services-ia-title"
    lead="Du site public à l'agent interne : trois leviers pour moderniser votre présence et vos processus, sans pile techno inutile."
    align="center"
  />

  <div class="mt-12 grid gap-6 lg:grid-cols-12 lg:gap-5">
    <article
      class="flex flex-col rounded-(--radius-sl-lg) border-2 border-sl-accent/40 bg-white p-7 shadow-[var(--shadow-sl-elevated)] lg:col-span-7"
    >
      <ServiceIcon id={featured.id as ServiceIconId} />
      <h3 class="mt-4 font-display text-xl font-semibold text-slate-900">{featured.title}</h3>
      <p class="mt-3 flex-1 text-base leading-relaxed text-slate-600">
        {featured.description}
      </p>
      <a
        href={featured.href}
        class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-sl-accent-text no-underline hover:text-sl-accent-hover hover:no-underline"
      >
        En savoir plus <span aria-hidden="true">→</span>
      </a>
    </article>

    <div class="flex flex-col gap-5 lg:col-span-5">
      {
        others.map((offer) => (
          <article class="flex flex-1 flex-col rounded-(--radius-sl-lg) border border-slate-200/90 bg-white p-6 shadow-[var(--shadow-sl-card)] transition hover:shadow-[var(--shadow-sl-elevated)]">
            <ServiceIcon id={offer.id as ServiceIconId} class="h-7 w-7 text-sl-accent-text" />
            <h3 class="mt-3 font-display text-lg font-semibold text-slate-900">
              {offer.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
              {offer.description}
            </p>
            <a
              href={offer.href}
              class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-sl-accent-text no-underline hover:text-sl-accent-hover hover:no-underline"
            >
              En savoir plus <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</SectionShell>
