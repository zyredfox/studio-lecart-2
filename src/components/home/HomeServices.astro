---
import { serviceOffers, siteConfig } from "@/config";
---

<section
  class="py-14 sm:py-16"
  aria-labelledby="services-ia-title"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-teal-700">
      {siteConfig.servicesIaSectionKicker}
    </p>
    <h2
      id="services-ia-title"
      class="mt-2 text-center font-display text-2xl font-bold text-slate-900 sm:text-3xl"
    >
      Services IA &amp; web
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-base text-slate-600">
      Du site public à l'agent interne : trois leviers pour moderniser votre présence et vos
      processus, sans pile techno inutile.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        serviceOffers.map((offer) => (
          <article
            class:list={[
              "flex flex-col rounded-2xl border bg-white p-6 shadow-sm transition hover:shadow-md",
              offer.featured
                ? "border-teal-300 ring-2 ring-teal-100 md:-translate-y-1"
                : "border-slate-200",
            ]}
          >
            <h3 class="font-display text-lg font-semibold text-slate-900">{offer.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
              {offer.description}
            </p>
            <a
              href={offer.href}
              class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-teal-700 no-underline hover:text-teal-900 hover:no-underline"
            >
              En savoir plus <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
