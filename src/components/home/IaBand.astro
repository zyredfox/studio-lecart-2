---
import { iaBandContent } from "@/config";
import { siteConfig } from "@/config/site";
import SectionShell from "@/components/ui/SectionShell.astro";
---

<SectionShell tone="default" class="!py-12 sm:!py-16">
  <div
    class="relative overflow-hidden rounded-(--radius-sl-lg) border border-teal-400/20 bg-gradient-to-br from-slate-900 via-teal-950 to-slate-900 p-8 shadow-[var(--shadow-sl-elevated)] sm:p-10"
    aria-labelledby="ia-band-title"
  >
    <div
      class="pointer-events-none absolute -left-20 top-0 h-56 w-56 rounded-full bg-teal-400/15 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-12 bottom-0 h-48 w-48 rounded-full bg-sl-warm/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative">
      <p class="sl-kicker text-teal-300">{siteConfig.servicesIaSectionKicker}</p>
      <h2
        id="ia-band-title"
        class="mt-2 font-display text-2xl font-bold text-white sm:text-3xl"
      >
        {iaBandContent.title}
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-200">
        {iaBandContent.body}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/services"
          class="inline-flex min-h-11 items-center justify-center rounded-(--radius-sl) bg-sl-accent px-5 text-sm font-semibold text-white no-underline hover:bg-teal-400 hover:no-underline"
        >
          Voir les services
        </a>
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center justify-center rounded-(--radius-sl) border border-white/30 bg-white/10 px-5 text-sm font-semibold text-white no-underline hover:bg-white/15 hover:no-underline"
        >
          Parler d'un cas concret
        </a>
      </div>
    </div>
  </div>
</SectionShell>
