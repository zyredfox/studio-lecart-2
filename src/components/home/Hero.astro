---
import { Image } from "astro:assets";
import {
  caseStudies,
  heroContent,
  heroFeaturedCaseStudyId,
  getPortfolioThumbnail,
  siteConfig,
} from "@/config";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";

const featured =
  caseStudies.find((s) => s.id === heroFeaturedCaseStudyId) ?? caseStudies[0];
const featuredThumb = getPortfolioThumbnail(featured.id);
const otherStudies = caseStudies.filter((s) => s.id !== featured.id);

const { title: heroTitle, titleEmphasis } = heroContent;
const emphasisIndex = heroTitle.indexOf(titleEmphasis);
const heroTitleHasEmphasis = emphasisIndex >= 0;
const heroTitleBefore = heroTitleHasEmphasis
  ? heroTitle.slice(0, emphasisIndex)
  : "";
const heroTitleAfter = heroTitleHasEmphasis
  ? heroTitle.slice(emphasisIndex + titleEmphasis.length)
  : "";
---

<section
  class="relative overflow-hidden border-b border-slate-200/80 py-14 sm:py-20"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-sl-accent/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-16 bottom-0 h-64 w-64 rounded-full bg-sl-warm/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div>
      <p class="text-sm font-medium text-slate-600">
        <span class="text-slate-900">{siteConfig.founderCity}</span>
        <span aria-hidden="true"> · </span>
        {
          siteConfig.heroPillsAfterCity.map((label, i) => (
            <>
              {i > 0 ? <span aria-hidden="true"> · </span> : null}
              <span>{label}</span>
            </>
          ))
        }
      </p>

      <h1
        id="hero-title"
        class="mt-4 font-display text-4xl font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl"
      >
        {
          heroTitleHasEmphasis ? (
            <>
              {heroTitleBefore}
              <em class="text-sl-accent-text not-italic">{titleEmphasis}</em>
              {heroTitleAfter}
            </>
          ) : (
            heroTitle
          )
        }
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-700">
        {siteConfig.founderIntro}
        {heroContent.leadSuffix}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="sl-btn-primary">
          Discuter avec {siteConfig.founderFirstName}
        </a>
        <a href="/a-propos" class="sl-btn-secondary"> Mon parcours </a>
      </div>

      <div
        class="mt-8 flex flex-wrap gap-2 text-xs text-slate-600"
        aria-label="Secteurs accompagnés"
      >
        <span class="rounded-md bg-white/90 px-2.5 py-1.5 ring-1 ring-slate-200/90">
          {siteConfig.founderCity} &amp; distance
        </span>
        {
          siteConfig.trustSectors.map((s) => (
            <span class="rounded-md bg-white/90 px-2.5 py-1.5 ring-1 ring-slate-200/90">
              {s}
            </span>
          ))
        }
      </div>
    </div>

    <div class="space-y-4" aria-label="Aperçu des réalisations">
      <BrowserFrame>
        <a
          href={`/portfolio#${featured.id}`}
          class="block no-underline hover:no-underline focus-visible:outline-sl-accent"
        >
          <Image
            src={featuredThumb}
            alt={`Capture du site ${featured.title}`}
            widths={[480, 640, 800, 960]}
            sizes="(max-width: 640px) 92vw, (max-width: 1024px) 48vw, 520px"
            class="aspect-[16/10] w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>
      </BrowserFrame>

      <div class="grid grid-cols-2 gap-3">
        {
          otherStudies.map((study) => {
            const thumb = getPortfolioThumbnail(study.id);
            return (
              <a
                href={`/portfolio#${study.id}`}
                class="group flex gap-3 overflow-hidden rounded-(--radius-sl) border border-slate-200/90 bg-white/95 p-2 no-underline shadow-[var(--shadow-sl-card)] transition-[box-shadow] hover:shadow-[var(--shadow-sl-elevated)] hover:no-underline focus-visible:outline-sl-accent"
              >
                <Image
                  src={thumb}
                  alt=""
                  widths={[112, 224, 336]}
                  sizes="112px"
                  class="h-[4.375rem] w-[7rem] shrink-0 rounded-md object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
                <span class="flex min-h-11 min-w-0 flex-col justify-center py-1">
                  <span class="text-xs font-semibold text-sl-accent-text">{study.sector}</span>
                  <span class="line-clamp-2 text-sm font-medium leading-snug text-slate-800 group-hover:text-sl-accent-hover">
                    {study.title.split("—")[0]?.trim() ?? study.title}
                  </span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
