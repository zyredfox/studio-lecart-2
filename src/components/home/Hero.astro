---
import { heroContent, siteConfig, founderInitials } from "@/config";
---

<section
  class="relative overflow-hidden border-b border-teal-900/10 py-12 sm:py-16"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-teal-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
    <div>
      <div
        class="mb-4 flex flex-wrap gap-2"
        aria-label="Profil"
      >
        <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-medium text-teal-900">
          {siteConfig.founderCity}
        </span>
        {
          siteConfig.heroPillsAfterCity.map((label) => (
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
              {label}
            </span>
          ))
        }
      </div>

      <h1
        id="hero-title"
        class="font-display text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl"
      >
        Un site <em class="text-teal-700 not-italic">{heroContent.titleEmphasis}</em> et pro —
        sans la complexité inutile
      </h1>

      <p class="mt-4 text-sm text-slate-600 sm:text-base">
        Moi c'est <strong>{siteConfig.founderFirstName}</strong>, {siteConfig.founderAge} ans,
        basé à <strong>{siteConfig.founderCity}</strong>. {siteConfig.founderCredentials}
      </p>

      <p class="mt-3 text-base leading-relaxed text-slate-700">
        {siteConfig.founderIntro}
        {heroContent.leadSuffix}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center justify-center rounded-xl bg-teal-600 px-5 text-sm font-semibold text-white no-underline shadow-md hover:bg-teal-700 hover:no-underline"
        >
          Discuter avec {siteConfig.founderFirstName}
        </a>
        <a
          href="/a-propos"
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-800 no-underline hover:border-teal-300 hover:text-teal-800 hover:no-underline"
        >
          Mon parcours
        </a>
      </div>

      <div
        class="mt-6 flex flex-wrap gap-2 text-xs text-slate-600"
        aria-label="Activité"
      >
        <span class="rounded-md bg-white/80 px-2 py-1 ring-1 ring-slate-200">
          {siteConfig.founderCity} & distance
        </span>
        {
          siteConfig.trustSectors.map((s) => (
            <span class="rounded-md bg-white/80 px-2 py-1 ring-1 ring-slate-200">{s}</span>
          ))
        }
      </div>
    </div>

    <aside
      class="rounded-2xl border border-teal-900/10 bg-white/90 p-6 shadow-lg shadow-slate-900/5"
      aria-label="Présentation"
    >
      <div class="flex items-center gap-4">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-teal-600 to-teal-800 text-lg font-bold text-white"
          aria-hidden="true"
        >
          {founderInitials()}
        </div>
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Salut, je suis {siteConfig.founderFirstName}
          </h2>
          <p class="text-sm text-slate-600">
            {siteConfig.founderAge} ans · {siteConfig.founderCity}
          </p>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <span class="rounded-full bg-teal-50 px-3 py-1 text-xs font-medium text-teal-900">
          Ingénieur
        </span>
        <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-medium text-orange-900">
          Développeur
        </span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
          Data scientist
        </span>
      </div>

      <p class="mt-4 text-sm leading-relaxed text-slate-700">
        {heroContent.founderVoice}
      </p>

      <a
        href="/contact"
        class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-teal-700 no-underline hover:text-teal-900 hover:no-underline"
      >
        Écrire à {siteConfig.founderFirstName} →
      </a>
    </aside>
  </div>
</section>
