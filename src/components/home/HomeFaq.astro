---
import { buildHomeFaq } from "@/config";
import SectionShell from "@/components/ui/SectionShell.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

const faqItems = buildHomeFaq();
const midpoint = Math.ceil(faqItems.length / 2);
const faqLeft = faqItems.slice(0, midpoint);
const faqRight = faqItems.slice(midpoint);
---

<SectionShell tone="default">
  <SectionHeader
    kicker="Questions fréquentes"
    title="Ce que vous devez savoir sur Studio Lecart"
    titleId="faq-title"
    lead="Réponses factuelles — utiles pour vous comme pour les moteurs de recherche et les assistants IA."
    align="center"
  />

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      [faqLeft, faqRight].map((column) => (
        <div class="divide-y divide-slate-200 rounded-(--radius-sl-lg) border border-slate-200/90 bg-white shadow-[var(--shadow-sl-card)]">
          {column.map((item) => (
            <details class="group px-4 py-1 sm:px-5">
              <summary
                class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 text-left text-sm font-semibold text-slate-900 marker:content-none [&::-webkit-details-marker]:hidden"
              >
                {item.question}
                <span
                  class="shrink-0 text-sl-accent transition motion-safe:group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="pb-4 text-sm leading-relaxed text-slate-700">{item.answer}</p>
            </details>
          ))}
        </div>
      ))
    }
  </div>
</SectionShell>
