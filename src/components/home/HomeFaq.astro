---
import { buildHomeFaq } from "@/config";

const faqItems = buildHomeFaq();
---

<section
  class="border-t border-slate-200/80 bg-white/60 py-14 sm:py-16"
  aria-labelledby="faq-title"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">
      Questions fréquentes
    </p>
    <h2
      id="faq-title"
      class="mt-2 font-display text-2xl font-bold text-slate-900 sm:text-3xl"
    >
      Ce que vous devez savoir sur Studio Lecart
    </h2>
    <p class="mt-3 text-sm text-slate-600">
      Réponses factuelles — utiles pour vous comme pour les moteurs de recherche et les assistants
      IA.
    </p>

    <div class="mt-8 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {
        faqItems.map((item) => (
          <details class="group px-4 py-1 sm:px-5">
            <summary
              class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 text-left text-sm font-semibold text-slate-900 marker:content-none [&::-webkit-details-marker]:hidden"
            >
              {item.question}
              <span
                class="shrink-0 text-teal-600 transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="pb-4 text-sm leading-relaxed text-slate-700">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
