---
import { homeStats } from "@/config";
---

<div
  class="border-b border-slate-200/80 bg-white/50 py-8"
  aria-label="En bref"
>
  <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:grid-cols-3 sm:px-6">
    {
      homeStats.map((stat) => (
        <div class="rounded-xl border border-slate-200/80 bg-white/90 p-4">
          <strong class="block text-sm font-semibold text-slate-900">{stat.title}</strong>
          <span class="mt-1 block text-sm text-slate-600">{stat.description}</span>
        </div>
      ))
    }
  </div>
</div>
