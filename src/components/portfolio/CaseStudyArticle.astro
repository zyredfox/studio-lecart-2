---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CaseStudy } from "@/config/types";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";

interface Props {
  study: CaseStudy;
  thumbnail: ImageMetadata;
}

const { study, thumbnail } = Astro.props;

const imageWidths = [720, 960, 1280, 1536, 1920];
const imageSizes = "(max-width: 1024px) 100vw, 52vw";
---

<article
  id={study.id}
  class="scroll-mt-24 grid gap-0 overflow-hidden rounded-(--radius-sl-lg) border border-slate-200/90 bg-white shadow-[var(--shadow-sl-card)] lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start"
  itemscope
  itemtype="https://schema.org/CreativeWork"
>
  <div class="order-2 flex flex-col p-6 sm:p-8 lg:order-1 lg:col-start-1 lg:row-start-1">
    <header class="border-b border-slate-100 pb-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-sl-accent-text">
        {study.sector}
      </p>
      <h2 class="mt-2 font-display text-xl font-bold text-slate-900 sm:text-2xl" itemprop="name">
        {study.title}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{study.cardSummary}</p>
      <p class="mt-3 text-sm font-medium text-slate-800">
        <span class="text-slate-500">Client :</span> {study.client}
      </p>
      {
        study.resultUrl ? (
          <p class="mt-2">
            <a
              href={study.resultUrl}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-sl-accent-text no-underline hover:text-sl-accent-hover hover:no-underline"
              itemprop="url"
              rel="noopener noreferrer"
              target="_blank"
            >
              Voir le site en ligne <span aria-hidden="true">↗</span>
            </a>
          </p>
        ) : null
      }
    </header>

    <section class="mt-5" aria-labelledby={`${study.id}-problem`}>
      <h3
        id={`${study.id}-problem`}
        class="text-sm font-semibold uppercase tracking-wide text-sl-accent-text"
      >
        Le besoin
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-700" itemprop="description">
        {study.problem}
      </p>
    </section>

    <section class="mt-5" aria-labelledby={`${study.id}-solution`}>
      <h3
        id={`${study.id}-solution`}
        class="text-sm font-semibold uppercase tracking-wide text-sl-accent-text"
      >
        Ce qu'on a mis en place
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">
        {study.solution}
      </p>
    </section>

    <section class="mt-5" aria-labelledby={`${study.id}-outcomes`}>
      <h3
        id={`${study.id}-outcomes`}
        class="text-sm font-semibold uppercase tracking-wide text-sl-accent-text"
      >
        Ce que ça change
      </h3>
      <ul class="mt-2 space-y-2 text-sm text-slate-700" role="list">
        {
          study.outcomes.map((outcome) => (
            <li class="flex gap-2">
              <span
                class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sl-accent"
                aria-hidden="true"
              />
              <span>{outcome}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div
    class="order-1 border-b border-slate-200/90 bg-white p-0 lg:order-2 lg:sticky lg:top-24 lg:col-start-2 lg:row-start-1 lg:self-start lg:border-b-0 lg:border-l"
  >
    <BrowserFrame variant="flush">
      <Image
        src={thumbnail}
        alt={`Capture du site ${study.title}`}
        widths={imageWidths}
        sizes={imageSizes}
        quality={88}
        class="block h-auto w-full"
        loading="lazy"
        decoding="async"
      />
    </BrowserFrame>
  </div>
</article>
