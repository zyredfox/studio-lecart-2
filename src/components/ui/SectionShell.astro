---
export type SectionTone = "default" | "muted" | "inset" | "dark";

interface Props {
  tone?: SectionTone;
  id?: string;
  class?: string;
  /** Pleine largeur sans max-w sur le fond */
  fullBleed?: boolean;
}

const { tone = "default", id, class: className = "", fullBleed = false } = Astro.props;

const toneClasses: Record<SectionTone, string> = {
  default: "bg-white border-b border-slate-200/60",
  muted: "bg-slate-50 border-y border-slate-200/80",
  inset: "bg-slate-100/90 border-b border-slate-200/60",
  dark: "",
};

const innerClass = fullBleed && tone === "dark" ? "" : "mx-auto max-w-7xl px-4 sm:px-6";
---

<section
  id={id}
  class:list={["py-16 sm:py-20", toneClasses[tone], className]}
>
  <div class={innerClass}>
    <slot />
  </div>
</section>
