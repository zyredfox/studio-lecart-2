---
import SectionShell from "@/components/ui/SectionShell.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { agencyValues, aProposPageLead, siteConfig } from "@/config";
---

<!-- Hero pleine largeur -->
<header class="border-b border-slate-200/80 bg-white py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="sl-kicker">À propos</p>
    <h1
      class="mt-2 max-w-3xl font-display text-3xl font-bold leading-[1.1] tracking-tight text-slate-900 sm:text-4xl lg:text-[2.75rem]"
    >
      {siteConfig.founderFirstName}, {siteConfig.founderAge} ans
      <span class="text-sl-accent-text"> · {siteConfig.founderCity}</span>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-700 sm:text-lg">
      {aProposPageLead}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contact" class="sl-btn-primary">
        Parler à {siteConfig.founderFirstName}
      </a>
      <a href="/portfolio" class="sl-btn-secondary"> Voir le portfolio </a>
    </div>
  </div>
</header>

<!-- Parcours : texte + citation -->
<SectionShell tone="inset" class="!py-12 sm:!py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:gap-14 xl:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2
        id="parcours-title"
        class="font-display text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        Mon approche
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">
        {siteConfig.founderCredentials}
      </p>
      <blockquote
        class="mt-8 rounded-(--radius-sl-lg) border border-teal-200/80 bg-white px-5 py-4 text-base leading-relaxed text-slate-800 shadow-[var(--shadow-sl-card)]"
      >
        <p class="italic">« {siteConfig.founderIntro} »</p>
      </blockquote>
    </div>

    <div class="space-y-5 text-base leading-relaxed text-slate-700" aria-labelledby="parcours-title">
      <p>
        Mon parcours combine <strong>ingénierie</strong>, <strong>développement web</strong> et une
        culture <strong>data</strong> : je livre des sites propres et j'ajoute une automation ou un
        assistant seulement quand le retour est mesurable — pas parce que « il faut de l'IA ».
      </p>
      <p>
        Basé à <strong>{siteConfig.founderCity}</strong> (Isère, Auvergne-Rhône-Alpes), j'interviens en
        présentiel dans la région grenobloise et à distance partout en France. L'objectif : une présence
        web claire, sans vous transformer en technicien du jour au lendemain.
      </p>
      <p>
        Via <strong>{siteConfig.siteName}</strong>, je propose des sites vitrine sur mesure (souvent en
        Astro SSG pour la performance et le SEO), des bases de référencement, puis — quand vous êtes
        prêts — des branchements ou automatisations ciblées. Fil conducteur : du concret, des délais
        tenus, un langage qu'on comprend entre nous.
      </p>
    </div>
  </div>
</SectionShell>

<!-- Valeurs en grille -->
<SectionShell tone="muted">
  <SectionHeader
    kicker="Positionnement"
    title="Valeurs de l'agence"
    titleId="valeurs-title"
    lead="Ce qui guide chaque projet chez Studio Lecart — du premier échange à la mise en ligne."
  />

  <ul
    class="mt-10 grid gap-4 sm:grid-cols-2 lg:gap-5"
    role="list"
    aria-labelledby="valeurs-title"
  >
    {
      agencyValues.map((value) => (
        <li class="flex flex-col rounded-(--radius-sl-lg) border border-slate-200/90 bg-white p-5 shadow-[var(--shadow-sl-card)] sm:p-6">
          <h3 class="font-display text-lg font-semibold text-slate-900">{value.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-700">{value.description}</p>
        </li>
      ))
    }
  </ul>
</SectionShell>

<!-- Local + CTA -->
<SectionShell tone="default" class="!py-12 sm:!py-14">
  <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
    <section
      class="rounded-(--radius-sl-lg) border border-slate-200/90 bg-slate-50 p-6 sm:p-7"
      aria-labelledby="local-title"
    >
      <h2 id="local-title" class="font-display text-xl font-semibold text-slate-900">
        Ancrage local — {siteConfig.founderCity}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-700 sm:text-base">
        Studio Lecart est basé à <strong>{siteConfig.founderCity}</strong>, France. Coordonnées :
        <a
          href={`mailto:${siteConfig.email}`}
          class="font-medium text-sl-accent-text no-underline hover:text-sl-accent-hover hover:underline"
        >
          {siteConfig.email}
        </a>
        , téléphone
        <a
          href={`tel:${siteConfig.phone}`}
          class="font-medium text-sl-accent-text no-underline hover:text-sl-accent-hover hover:underline"
        >
          {siteConfig.phoneDisplay}
        </a>
        . Adresse : {siteConfig.addressLine}.
      </p>
    </section>

    <section
      class="flex flex-col justify-center rounded-(--radius-sl-lg) border border-teal-200/60 bg-gradient-to-br from-teal-800 to-slate-900 p-6 text-white sm:p-8"
      aria-labelledby="cta-apropos-title"
    >
      <h2 id="cta-apropos-title" class="font-display text-xl font-bold sm:text-2xl">
        Un projet en tête ?
      </h2>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-teal-50/95 sm:text-base">
        Décrivez votre activité en quelques lignes : je vous réponds sous quelques jours ouvrés avec
        une proposition claire — sans engagement.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center justify-center rounded-(--radius-sl) bg-white px-5 text-sm font-semibold text-teal-900 no-underline transition hover:bg-teal-50 hover:no-underline"
        >
          Prendre contact
        </a>
        <a
          href="/methode"
          class="inline-flex min-h-11 items-center justify-center rounded-(--radius-sl) border border-white/35 bg-white/10 px-5 text-sm font-semibold text-white no-underline hover:bg-white/15 hover:no-underline"
        >
          Voir la méthode
        </a>
      </div>
    </section>
  </div>
</SectionShell>
